{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ruinas Esquecidas",
  "version": "0.1.0",
  "identifier": "io.github.joaobrocua.ruinas-esquecidas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Joao Pedro",
    "shortDescription": "Roguelite 2D de ação lateral em fantasia sombria",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
